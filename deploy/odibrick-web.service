# systemd alternative to PM2 for the web app.

[Unit]
Description=Odibrick Web (Next.js)
After=network.target odibrick-api.service
Wants=odibrick-api.service

[Service]
Type=simple
User=odibrick
Group=odibrick
WorkingDirectory=/var/www/odibrick/apps/web
EnvironmentFile=/var/www/odibrick/apps/web/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5
StandardOutput=append:/var/log/odibrick/web.out.log
StandardError=append:/var/log/odibrick/web.error.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/odibrick/apps/web/.next /var/log/odibrick
MemoryMax=1G

[Install]
WantedBy=multi-user.target
