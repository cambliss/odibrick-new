# ---------- runtime ----------
NODE_ENV=production
API_PORT=4000
API_PREFIX=api
PUBLIC_WEB_URL=https://odibrick.com
CORS_ORIGINS=https://odibrick.com,https://www.odibrick.com

# ---------- database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=odibrick
DB_PASSWORD=change-me
DB_NAME=odibrick
DB_CONNECTION_LIMIT=15

# ---------- auth ----------
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-48
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=generate-another-one
JWT_REFRESH_TTL_DAYS=30
PASSWORD_PEPPER=generate-another-one
FIELD_ENCRYPTION_KEY=64-hex-chars-32-bytes-aes-256-gcm-key

# ---------- storage ----------
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_ROOT=/var/lib/odibrick/storage
SIGNED_URL_TTL=300
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- providers (all abstracted; leave unset until contracted) ----------
PAYMENT_PROVIDER=manual
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
VIDEO_PROVIDER=pending
KYC_PROVIDER=manual
INSURANCE_PROVIDER=manual
NOTIFICATION_EMAIL_PROVIDER=log
NOTIFICATION_SMS_PROVIDER=log
